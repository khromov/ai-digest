{
  "name": "ai-digest",
  "version": "1.6.0",
  "description": "CLI tool to aggregate files into a single Markdown file",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ai-digest": "dist/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "rimraf dist/ && tsc",
    "start": "ts-node src/index.ts",
    "prepublishOnly": "npm run build",
    "test": "jest --config jest.config.js",
    "lint": "eslint \"src/**/*.{js,ts}\"",
    "format": "eslint \"src/**/*.{js,ts}\" --fix",
    "prettier": "prettier --write \"src/**/*.{js,ts,json}\" \"!src/**/*.snap\"",
    "analyze-tokens": "ts-node scripts/analyze-token-ratio.ts",
    "calculate-multiplier": "ts-node scripts/calculate-multiplier.ts",
    "test-multiplier": "ts-node scripts/test-multiplier.ts",
    "prepare": "husky"
  },
  "keywords": [
    "cli",
    "aggregate",
    "markdown"
  ],
  "author": "Stanislav Khromov",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^14.0.3",
    "glob": "^11.1.0",
    "ignore": "^7.0.12",
    "isbinaryfile": "^5.0.7",
    "tiktoken": "^1.0.22"
  },
  "homepage": "https://github.com/khromov/ai-digest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khromov/ai-digest.git"
  },
  "bugs": {
    "url": "https://github.com/khromov/ai-digest/issues"
  },
  "lint-staged": {
    "src/**/*.{js,ts}": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    }
  }
}
